+	ram_ldqm : out std_logic;
+	ram_udqm : out std_logic;
+
+-- Video - direct VGA, 5/6/5
+	red : out unsigned(4 downto 0);
+	grn : out unsigned(5 downto 0);
+	blu : out unsigned(4 downto 0);
+	hsync_oc : out std_logic;   -- drive '1' to pull nHSync low
+	vsync_oc : out std_logic;   -- drive '1' to pull nVSync low
+
+-- Audio - extender DAC pins (fill in from C1_extender.pin)
+	sigma_l : out std_logic;
+	sigma_r : out std_logic
+);
+end entity;
+
+architecture rtl of cone_ext_top is
+	constant reset_cycles : integer := 131071;
+
+-- System clocks
+	signal clk_100 : std_logic;
+	signal clk_50 : std_logic;
+	signal clk_27 : std_logic;
+	signal pll_locked : std_logic;
+
+-- Global signals
+	signal reset_14 : std_logic;
+	signal reset_100 : std_logic;
+	signal reset : std_logic;
+	signal reset_n : std_logic;
+
+-- PS/2
+	signal ps2_keyboard_clk_in, ps2_keyboard_dat_in : std_logic;
+	signal ps2_keyboard_clk_out, ps2_keyboard_dat_out : std_logic;
+	signal ps2_mouse_clk_in, ps2_mouse_dat_in : std_logic;
+	signal ps2_mouse_clk_out, ps2_mouse_dat_out : std_logic;
+	signal intercept : std_logic;
+
+-- SD card (raw SPI to cone_sd_ata)
+	signal spi_mosi : std_logic;
+	signal spi_miso : std_logic;
+	signal mmc_cs : std_logic;
+	signal spi_clk : std_logic;
+
+-- IDE register access (cone_sd_ata -> cone_mm_link)
+	signal ide_req, ide_wr, ide_ack, link_ok : std_logic;
+	signal ide_reg : std_logic_vector(2 downto 0);
+	signal ide_wdata, ide_rdata : std_logic_vector(15 downto 0);
+
+-- internal SPI signals (controller <-> guest)
+	signal spi_do : std_logic;
+	signal spi_toguest : std_logic;
+	signal spi_fromguest : std_logic;
+	signal spi_ss2, spi_ss3, spi_ss4 : std_logic;
+	signal conf_data0 : std_logic;
+	signal spi_clk_int : std_logic;
+
+-- RS232: TxD reaches the 1k30's TxD pin; Minimig's 1k30 sends no RxD
+	signal rs232_rxd : std_logic := '1';
+	signal rs232_txd : std_logic;
+
+-- IO
+	signal cone_joy_a : unsigned(5 downto 0);
+	signal cone_joy_b : unsigned(5 downto 0);
+	signal joy1 : std_logic_vector(demistify_joybits-1 downto 0);
+	signal joy2 : std_logic_vector(demistify_joybits-1 downto 0);
+
+-- SDRAM address from guest (13 bits; the extender wires A[11:0])
+	signal sdram_a : std_logic_vector(12 downto 0);
+
+-- Video from guest
+	signal vga_hsync, vga_vsync : std_logic;
+	signal vga_red, vga_green, vga_blue : std_logic_vector(7 downto 0);
+
+begin
+-- -----------------------------------------------------------------------
+-- Clocks and reset
+-- -----------------------------------------------------------------------
+	clocks : entity work.hostclocks
+	port map (
+		inclk0 => clk14,
+		c0 => clk_100,
+		c1 => clk_50,
+		c2 => clk_27,
+		locked => pll_locked
+	);
+
+	myReset : entity work.gen_reset
+	generic map ( resetCycles => reset_cycles )
+	port map (
+		clk => clk14,
+		enable => '1',
+		button => not pll_locked,
+		reset => reset_14
+	);
+
+	process(clk_100)
+	begin
+		if rising_edge(clk_100) then
+			reset_100 <= reset_14;
+			reset <= reset_100;
+		end if;
+	end process;
+
+-- -----------------------------------------------------------------------
+-- vid bus to the 1k30: Minimig V2.01 link (IOclk = clk_100 / 2) and the
+-- SD-to-ATA bridge on its IDE port (CF card, device 0 on CS0)
+-- -----------------------------------------------------------------------
+	link : entity work.cone_mm_link
+	port map (
+		clk => clk_100,
+		reset => reset,
+		vid_ioclk => vid_ioclk,
+		vid_ser_out => vid_ser_out,
+		vid_ser_in => vid_ser_in,
+		vid_ide_out => vid_ide_out,
+		vid_ide_in => vid_ide_in,
+
+		ide_req => ide_req,
+		ide_wr => ide_wr,
+		ide_cs0 => '1',
+		ide_cs1 => '0',
+		ide_reg => ide_reg,
+		ide_wdata => ide_wdata,
+		ide_rdata => ide_rdata,
+		ide_ack => ide_ack,
+
+		ps2k_clk_out => ps2_keyboard_clk_out,
+		ps2k_dat_out => ps2_keyboard_dat_out,
+		ps2m_clk_out => ps2_mouse_clk_out,
+		ps2m_dat_out => ps2_mouse_dat_out,
+		ps2k_clk_in => ps2_keyboard_clk_in,
+		ps2k_dat_in => ps2_keyboard_dat_in,
+		ps2m_clk_in => ps2_mouse_clk_in,
+		ps2m_dat_in => ps2_mouse_dat_in,
+
+		txd => rs232_txd,
+		rxd => open,
+		sync_ok => link_ok,
+
+		joy_a => cone_joy_a,
+		joy_b => cone_joy_b,
+
+		-- the guest's audio stays on the sigma-delta pins; the 1k30's
+		-- serial DAC gets silence
+		audio_l => (others => '0'),
+		audio_r => (others => '0')
+	);
+	vid_spare_out <= '1';
+
+	sd_bridge : entity work.cone_sd_ata
+	port map (
+		clk => clk_100,
+		reset => reset,
+		spi_cs_n => mmc_cs,
+		spi_sck => spi_clk,
+		spi_mosi => spi_mosi,
+		spi_miso => spi_miso,
+		link_ok => link_ok,
+		ide_req => ide_req,
+		ide_wr => ide_wr,
+		ide_reg => ide_reg,
+		ide_wdata => ide_wdata,
+		ide_rdata => ide_rdata,
+		ide_ack => ide_ack
+	);
+
+	-- C-One ports -> substitute_mcu joystick words (active low, buttons at
+	-- the core's demistify_button1/2 positions).
+	mergeinputs : entity work.cone_mergeinputs
+	generic map (
+		joybits => demistify_joybits,
+		button1 => demistify_button1,
+		button2 => demistify_button2
+	)
+	port map (
+		clk => clk_100,
+		joy_a => cone_joy_a,
+		joy_b => cone_joy_b,
+		joy1_out => joy1,
+		joy2_out => joy2
+	);
+
+-- -----------------------------------------------------------------------
+-- Guest core
+-- -----------------------------------------------------------------------
+	spi_do <= spi_miso when spi_ss4 = '0' else 'Z';
+	spi_fromguest <= spi_do;
+
+	guest : component guest
+	port map (
+		CLOCK_27 => clk_27,            -- or clk_27&clk_27 for cores with a 2-bit CLOCK_27
+--		RESET_N => reset_n,
+		LED => open,
+		-- SDRAM. Guest cores drive 13 address bits; A[12] has no pin.
+		SDRAM_DQ => ram_data,
+		SDRAM_A => sdram_a,
+		SDRAM_DQML => ram_ldqm,
+		SDRAM_DQMH => ram_udqm,
+		SDRAM_nWE => ram_we_n,
+		SDRAM_nCAS => ram_cas_n,
+		SDRAM_nRAS => ram_ras_n,
+--		SDRAM_nCS => open,             -- hardwired on the extender
+		SDRAM_BA(0) => ram_ba_0,
+		SDRAM_BA(1) => ram_ba_1,
+		SDRAM_CLK => ram_clk,
+--		SDRAM_CKE => open,             -- hardwired on the extender
+		-- SPI interface to control module
+		SPI_DO => spi_do,
+		SPI_DI => spi_toguest,
+		SPI_SCK => spi_clk_int,
+		SPI_SS2 => spi_ss2,
+		SPI_SS3 => spi_ss3,
+		SPI_SS4 => spi_ss4,
+		CONF_DATA0 => conf_data0,
+		-- Video output
+		VGA_HS => vga_hsync,
+		VGA_VS => vga_vsync,
+		VGA_R => vga_red(7 downto 2),
+		VGA_G => vga_green(7 downto 2),
+		VGA_B => vga_blue(7 downto 2),
+		-- Audio output (sigma-delta from the guest)
+		AUDIO_L => sigma_l,
+		AUDIO_R => sigma_r
+	);
+
+	ram_addr <= sdram_a(11 downto 0);
+
+	-- VGA: extender has 5/6/5 bits and open-collector sync drivers.
+	red <= unsigned(vga_red(7 downto 3));
+	grn <= unsigned(vga_green(7 downto 2));
+	blu <= unsigned(vga_blue(7 downto 3));
+	hsync_oc <= not vga_hsync;   -- MiST cores output active-low sync;
+	vsync_oc <= not vga_vsync;   -- '1' here pulls the shared line low.
+
+-- -----------------------------------------------------------------------
+-- Control module (replaces the MiST ARM)
+-- -----------------------------------------------------------------------
+	spi_clk <= spi_clk_int;
+
+	controller : entity work.substitute_mcu
+	generic map (
+		joybits => demistify_joybits,
+		sysclk_frequency => 500,
+		debug => false,
+		jtag_uart => false,
+		SPI_FASTBIT => 0,
+		-- cone_sd_ata is an on-chip slave: it answers a rising SCK within
+		-- one clk_100 cycle and MISO is next sampled a full SCK period later,
+		-- so no handshake is needed (the slow init clock ignores spi_ack
+		-- in either mode, substitute_mcu.vhd:373-383).
+		SPI_EXTERNALCLK => false
+	)
+	port map (
+		clk => clk_50,
+		reset_in => not reset,
+		reset_out => reset_n,
+		-- SPI
+		spi_miso => spi_miso,
+		spi_mosi => spi_mosi,
+		spi_clk => spi_clk_int,
+		spi_cs => mmc_cs,
+		spi_fromguest => spi_fromguest,
+		spi_toguest => spi_toguest,
+		spi_ss2 => spi_ss2,
+		spi_ss3 => spi_ss3,
+		spi_ss4 => spi_ss4,
+		conf_data0 => conf_data0,
+		spi_req => open,
+		-- PS/2
+		ps2k_clk_in => ps2_keyboard_clk_in,
+		ps2k_dat_in => ps2_keyboard_dat_in,
+		ps2k_clk_out => ps2_keyboard_clk_out,
+		ps2k_dat_out => ps2_keyboard_dat_out,
+		ps2m_clk_in => ps2_mouse_clk_in,
+		ps2m_dat_in => ps2_mouse_dat_in,
+		ps2m_clk_out => ps2_mouse_clk_out,
+		ps2m_dat_out => ps2_mouse_dat_out,
+		-- Joysticks
+		joy1 => joy1,
+		joy2 => joy2,
+		buttons => (others => '1'),    -- none on the C-One; the OSD opens from the keyboard
+		-- UART
+		rxd => rs232_rxd,
+		txd => rs232_txd,
+		intercept => intercept
+	);
+
+end architecture;
