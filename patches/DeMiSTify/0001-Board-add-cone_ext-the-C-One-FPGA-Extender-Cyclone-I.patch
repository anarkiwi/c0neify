+# Device settings - same silicon as MiST and Chameleon V1
+set_global_assignment -name FAMILY "Cyclone III"
+set_global_assignment -name DEVICE EP3C25E144C8
+set_global_assignment -name DEVICE_FILTER_PACKAGE TQFP
+set_global_assignment -name DEVICE_FILTER_PIN_COUNT 144
+set_global_assignment -name DEVICE_FILTER_SPEED_GRADE 8
+set_global_assignment -name LAST_QUARTUS_VERSION 13.1
+
+set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
+set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
+
+# The 1k30 configures the extender in passive serial from extender.rbf,
+# so no configuration device, and reclaim the config pins as I/O.
+set_global_assignment -name USE_CONFIGURATION_DEVICE OFF
+set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
+set_global_assignment -name RESERVE_DATA0_AFTER_CONFIGURATION "USE AS REGULAR IO"
+set_global_assignment -name RESERVE_DATA1_AFTER_CONFIGURATION "USE AS REGULAR IO"
+set_global_assignment -name RESERVE_FLASH_NCE_AFTER_CONFIGURATION "USE AS REGULAR IO"
+set_global_assignment -name RESERVE_DCLK_AFTER_CONFIGURATION "USE AS REGULAR IO"
+set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION ON
+set_global_assignment -name GENERATE_RBF_FILE ON
+set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
+
+set_global_assignment -name SMART_RECOMPILE ON
+set_global_assignment -name OPTIMIZE_HOLD_TIMING "ALL PATHS"
+set_global_assignment -name OPTIMIZE_MULTI_CORNER_TIMING ON
+set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
+set_global_assignment -name ENABLE_CLOCK_LATENCY ON
+set_global_assignment -name PHYSICAL_SYNTHESIS_EFFORT NORMAL
+
+if {[info exists optimizeforspeed] && ($optimizeforspeed==1)} {
+	set_global_assignment -name CYCLONEII_OPTIMIZATION_TECHNIQUE SPEED
+} else {
+	set_global_assignment -name CYCLONEII_OPTIMIZATION_TECHNIQUE BALANCED
+}
+
+set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
+set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
+set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
+set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
diff --git a/Board/cone_ext/cone_ext_pins.tcl b/Board/cone_ext/cone_ext_pins.tcl
new file mode 100644
index 0000000..5728eb8
--- /dev/null
+++ b/Board/cone_ext/cone_ext_pins.tcl
@@ -0,0 +1,158 @@
+# C-One FPGA Extender (Cyclone III EP3C25E144C8) pin assignments
+# for a DeMiSTify "cone_ext" board target.
+#
+# Source: Peter Wendrich, "C-One core development", section 13
+# (Pins and Signals), Ext. column, July 2010.
+# Cross-check against C1_extender.pin from the iComp wiki before first use:
+# that file is taken directly from the working Minimig Quartus project.
+#
+# Naming follows the DeMiSTify Chameleon convention (red/grn/blu,
+# ram_*, sigma_*) so the Chameleon templates port with minimal edits.
+
+# ---------------------------------------------------------------
+# Clocks (extender has its own crystals)
+# ---------------------------------------------------------------
+set_location_assignment PIN_55  -to clk14      ;# 14.31818 MHz (4x NTSC colour burst)
+set_location_assignment PIN_126 -to clk28      ;# 28.37516 MHz (PAL-derived)
+
+# ---------------------------------------------------------------
+# VGA - direct from extender. 5/6/5 bits.
+# ---------------------------------------------------------------
+set_location_assignment PIN_86 -to red[0]
+set_location_assignment PIN_85 -to red[1]
+set_location_assignment PIN_83 -to red[2]
+set_location_assignment PIN_80 -to red[3]
+set_location_assignment PIN_77 -to red[4]
+
+set_location_assignment PIN_72 -to grn[0]
+set_location_assignment PIN_69 -to grn[1]
+set_location_assignment PIN_67 -to grn[2]
+set_location_assignment PIN_65 -to grn[3]
+set_location_assignment PIN_64 -to grn[4]
+set_location_assignment PIN_59 -to grn[5]
+
+set_location_assignment PIN_49 -to blu[0]
+set_location_assignment PIN_51 -to blu[1]
+set_location_assignment PIN_50 -to blu[2]
+set_location_assignment PIN_44 -to blu[3]
+set_location_assignment PIN_42 -to blu[4]
+
+# Sync lines are shared with the 1k30 and are open-collector from the
+# extender side: drive the FPGA pin HIGH to pull the sync line LOW.
+# NewBoot tri-states the 1k30's sync outputs when it loads extender.rbf.
+set_location_assignment PIN_33 -to hsync_oc    ;# nHSync, drive '1' = line low
+set_location_assignment PIN_39 -to vsync_oc    ;# nVSync, drive '1' = line low
+
+# ---------------------------------------------------------------
+# SDRAM - 16 MB, 4 banks x 4096 rows x 512 cols x 16 bit (128 Mbit)
+# A0..A11 only (12 row bits). reference/C1_extender_schem.pdf: U2 is a
+# Samsung K4S281632-UC60 ("128MBit SD-Ram ... 166 MHz type"); CKE is tied
+# to V33 and nCS to ground (with NC1/pin 36, "grounded for 256MBit
+# compatibility"), so neither has an FPGA pin.
+# ---------------------------------------------------------------
+set_location_assignment PIN_99  -to ram_clk
+set_location_assignment PIN_32  -to ram_ras_n
+set_location_assignment PIN_144 -to ram_cas_n
+set_location_assignment PIN_143 -to ram_we_n
+set_location_assignment PIN_31  -to ram_ba_0
+set_location_assignment PIN_30  -to ram_ba_1
+set_location_assignment PIN_142 -to ram_ldqm
+set_location_assignment PIN_98  -to ram_udqm
+
+set_location_assignment PIN_8   -to ram_addr[0]
+set_location_assignment PIN_7   -to ram_addr[1]
+set_location_assignment PIN_6   -to ram_addr[2]
+set_location_assignment PIN_4   -to ram_addr[3]
+set_location_assignment PIN_119 -to ram_addr[4]
+set_location_assignment PIN_114 -to ram_addr[5]
+set_location_assignment PIN_112 -to ram_addr[6]
+set_location_assignment PIN_110 -to ram_addr[7]
+set_location_assignment PIN_103 -to ram_addr[8]
+set_location_assignment PIN_105 -to ram_addr[9]
+set_location_assignment PIN_28  -to ram_addr[10]
+set_location_assignment PIN_100 -to ram_addr[11]
+
+set_location_assignment PIN_121 -to ram_data[0]
+set_location_assignment PIN_125 -to ram_data[1]
+set_location_assignment PIN_132 -to ram_data[2]
+set_location_assignment PIN_133 -to ram_data[3]
+set_location_assignment PIN_135 -to ram_data[4]
+set_location_assignment PIN_136 -to ram_data[5]
+set_location_assignment PIN_137 -to ram_data[6]
+set_location_assignment PIN_141 -to ram_data[7]
+set_location_assignment PIN_87  -to ram_data[8]
+set_location_assignment PIN_106 -to ram_data[9]
+set_location_assignment PIN_104 -to ram_data[10]
+set_location_assignment PIN_101 -to ram_data[11]
+set_location_assignment PIN_111 -to ram_data[12]
+set_location_assignment PIN_113 -to ram_data[13]
+set_location_assignment PIN_115 -to ram_data[14]
+set_location_assignment PIN_120 -to ram_data[15]
+
+# ---------------------------------------------------------------
+# "vid" bus - the 16 lines to the 1k30. In bypass mode these carry
+# RGB from the 1k30; once the extender is loaded they are the only
+# general-purpose link to the rest of the C-One, and therefore the
+# channel for keyboard, mouse, joysticks and CF block traffic.
+# Port names follow cone_mm_link (Minimig V2.01 link); vid index and
+# pin from the manual's table; every location and direction is the
+# one reference/C1_extender.pin uses (Minimig names in brackets).
+# Input-only locations (vid[3:0], vid[13:11]) are confirmed by the
+# Quartus 13.1 EP3C25E144 device database (fitter error 169009 for
+# any other direction).
+# ---------------------------------------------------------------
+set_location_assignment PIN_91 -to vid_ide_in[0]    ;# vid[0]  IN only [addbi[0]]
+set_location_assignment PIN_90 -to vid_ide_in[1]    ;# vid[1]  IN only [addbi[1]]
+set_location_assignment PIN_89 -to vid_ide_in[2]    ;# vid[2]  IN only [addbi[2]]
+set_location_assignment PIN_88 -to vid_ide_in[3]    ;# vid[3]  IN only [addbi[3]]
+set_location_assignment PIN_79 -to vid_ide_out[0]   ;# vid[4]  [addbo[0]]
+set_location_assignment PIN_76 -to vid_ide_out[1]   ;# vid[5]  [addbo[1]]
+set_location_assignment PIN_71 -to vid_ide_out[2]   ;# vid[6]  [addbo[2]]
+set_location_assignment PIN_68 -to vid_ide_out[3]   ;# vid[7]  [addbo[3]]
+set_location_assignment PIN_66 -to vid_ide_out[4]   ;# vid[8]  [addbo[4]]
+set_location_assignment PIN_60 -to vid_ide_out[5]   ;# vid[9]  [addbo[5]]
+set_location_assignment PIN_58 -to vid_spare_out    ;# vid[10] [addbo[6]]
+set_location_assignment PIN_54 -to vid_spare_in[0]  ;# vid[11] IN only [sysclk]
+set_location_assignment PIN_53 -to vid_spare_in[1]  ;# vid[12] IN only [addbi[4]]
+set_location_assignment PIN_52 -to vid_ser_in       ;# vid[13] IN only [addbi[5]]
+set_location_assignment PIN_46 -to vid_ser_out      ;# vid[14] [addbo[7]]
+set_location_assignment PIN_43 -to vid_ioclk        ;# vid[15] [addbo[8]]
+
+# Link data lines are registered in their I/O elements so they share one
+# clock-to-pin delay against vid_ioclk (constraints.sdc).
+set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to vid_ide_out[*]
+set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to vid_ser_out
+set_instance_assignment -name FAST_INPUT_REGISTER ON -to vid_ide_in[*]
+set_instance_assignment -name FAST_INPUT_REGISTER ON -to vid_ser_in
+
+# ---------------------------------------------------------------
+# mdb[7:0] - the board-wide 8-bit data bus (SID, cartridge, SRAM,
+# CPLDs). Slow (<=8-10 MHz) and owned by the 1k30/1k100 at run time.
+# mdb[3:0] sit on CLK0..CLK3 (pins 25,24,23,22); they and mdb[7:5]
+# (pins 127..129) are input-only locations (Quartus device database),
+# so the port is an input. reference/C1_extender.pin uses the same
+# names and locations, all as inputs.
+# ---------------------------------------------------------------
+set_location_assignment PIN_25  -to mdb[0]    ;# IN only (CLK0)
+set_location_assignment PIN_24  -to mdb[1]    ;# IN only (CLK1)
+set_location_assignment PIN_23  -to mdb[2]    ;# IN only (CLK2)
+set_location_assignment PIN_22  -to mdb[3]    ;# IN only (CLK3)
+set_location_assignment PIN_13  -to mdb[4]
+set_location_assignment PIN_127 -to mdb[5]
+set_location_assignment PIN_128 -to mdb[6]
+set_location_assignment PIN_129 -to mdb[7]
+
+# ---------------------------------------------------------------
+# Audio: not in the manual's table. Locations from
+# reference/C1_extender.pin (sigma1 PIN_10, sigma2 PIN_11, outputs,
+# 3.3-V LVTTL, bank 1). reference/C1_extender_schem.pdf: sigma1/sigma2
+# are the "sigma-delta converters" Audio1/Audio2 (4n7 to ground, 10k and
+# 1uF in series) to the geek port's SID1_exaudio / SID2_exaudio, i.e.
+# the C-One's two SID external-audio inputs; their stereo placement is
+# set by the main board.
+# ---------------------------------------------------------------
+set_location_assignment PIN_10 -to sigma_l     ;# [sigma1]
+set_location_assignment PIN_11 -to sigma_r     ;# [sigma2]
+
+# I/O standard: the whole bank set is 3.3 V LVTTL on the extender.
+set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
diff --git a/Board/cone_ext/cone_ext_support.tcl b/Board/cone_ext/cone_ext_support.tcl
new file mode 100644
index 0000000..2d39a25
--- /dev/null
+++ b/Board/cone_ext/cone_ext_support.tcl
@@ -0,0 +1,22 @@
+set_global_assignment -name SDC_FILE ${boardpath}/cone_ext/constraints.sdc
+set_global_assignment -name VHDL_FILE ${boardpath}/cone_ext/cone_mm_link.vhd
+set_global_assignment -name VHDL_FILE ${boardpath}/cone_ext/cone_sd_ata.vhd
+set_global_assignment -name VHDL_FILE ${boardpath}/cone_ext/cone_mergeinputs.vhd
+set_global_assignment -name VHDL_FILE ${boardpath}/cone_ext/gen_reset.vhd
+set_global_assignment -name QIP_FILE ${boardpath}/cone_ext/hostclocks.qip
+
+# 16 MB SDRAM on the extender: Samsung K4S281632-UC60 (C1_extender_schem.pdf),
+# 8M x 16, 12 row / 9 column bits. Timings from the K4S281632F datasheet
+# (reference/K4S280432F-UC.PDF, "SDRAM 128Mb F-die (x4, x8, x16)" Rev 1.2,
+# -60 column): tRC 60 ns, tRP 18 ns, tRDL 2 CLK, CL3 at tCK >= 6 ns.
+# The -60 grade has no CL2 rating, so SDRAM_tCKminCL2 is left undefined.
+set_global_assignment -name VERILOG_MACRO "SDRAM_WINBOND=0"
+set_global_assignment -name VERILOG_MACRO "SDRAM_ROWBITS=12"
+set_global_assignment -name VERILOG_MACRO "SDRAM_COLBITS=9"
+set_global_assignment -name VERILOG_MACRO "SDRAM_CL=3"
+set_global_assignment -name VERILOG_MACRO "SDRAM_tRC=60000"
+set_global_assignment -name VERILOG_MACRO "SDRAM_tWR=2"
+set_global_assignment -name VERILOG_MACRO "SDRAM_tRP=18000"
+
+# Keyboard reaches the extender as PS/2 tunnelled over the vid bus.
+set_global_assignment -name VERILOG_MACRO "DEMISTIFY_PS2_KEYBOARD=1"
diff --git a/Board/cone_ext/cone_mergeinputs.vhd b/Board/cone_ext/cone_mergeinputs.vhd
new file mode 100644
index 0000000..781964e
--- /dev/null
+++ b/Board/cone_ext/cone_mergeinputs.vhd
@@ -0,0 +1,56 @@
+-- -----------------------------------------------------------------------
+-- cone_mergeinputs.vhd
+--
+-- Maps the two C-One joystick ports into the joystick words expected by
+-- DeMiSTify's substitute_mcu (and by MiST guest cores): directions in bits
+-- 3..0 in the same up/down/left/right order as the C64 port, fire buttons
+-- at the core-specific positions demistify_button1/2 from
+-- demistify_config_pkg. Everything is active low on both sides, matching
+-- chameleon_mergeinputs and substitute_mcu's '1' defaults.
+--
+-- Input bit order (both ports): 5 fire2, 4 fire1, 3 right, 2 left, 1 down,
+-- 0 up. Plain VHDL-93 so the 1k30 side can share it.
+-- -----------------------------------------------------------------------
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+
+entity cone_mergeinputs is
+	generic (
+		joybits : integer := 8;
+		button1 : integer := 4;
+		button2 : integer := 5
+	);
+	port (
+		clk : in std_logic;
+		joy_a : in unsigned(5 downto 0);
+		joy_b : in unsigned(5 downto 0);
+		joy1_out : out std_logic_vector(joybits - 1 downto 0);
+		joy2_out : out std_logic_vector(joybits - 1 downto 0)
+	);
+end entity;
+
+architecture rtl of cone_mergeinputs is
+	function map_port(j : unsigned(5 downto 0)) return std_logic_vector is
+		variable r : std_logic_vector(joybits - 1 downto 0) := (others => '1');
+	begin
+		r(3 downto 0) := std_logic_vector(j(3 downto 0));
+		r(button1) := j(4);
+		r(button2) := j(5);
+		return r;
+	end function;
+begin
+	assert button1 >= 4 and button1 < joybits and button2 >= 4 and button2 < joybits
+		and button1 /= button2
+		report "cone_mergeinputs: button positions must be distinct and in 4..joybits-1"
+		severity failure;
+
+	process(clk)
+	begin
+		if rising_edge(clk) then
+			joy1_out <= map_port(joy_a);
+			joy2_out <= map_port(joy_b);
+		end if;
+	end process;
+end architecture;
diff --git a/Board/cone_ext/cone_mm_link.vhd b/Board/cone_ext/cone_mm_link.vhd
new file mode 100644
index 0000000..3609758
--- /dev/null
+++ b/Board/cone_ext/cone_mm_link.vhd
@@ -0,0 +1,307 @@
+-- -----------------------------------------------------------------------
+-- cone_mm_link.vhd
+--
+-- Extender side of the Minimig V2.01 C-One vid-bus link, so the prebuilt
+-- Minimig 1k30 image (support.bin, built from 1k30/acex.vhd) serves this
+-- core unchanged: IDE/CF register access, PS/2 keyboard and mouse, RS232
+-- TxD, both joysticks and the 1k30's serial audio DAC.
+--
+-- The link protocol, its cycle counts and slot order are Tobias Gubener's
+-- (Minimig C-One port, Copyright (c) 2008-2009 Tobias Gubener, GPL-3 or
+-- later). Citations are to C1minimigV201_source.zip: cfide.vhd (IDE
+-- tunnel), cyclone.vhd (serial slots, audio, joysticks), 1k30/acex.vhd
+-- (the 1k30 end). Copyright (c) 2026 Josh Bailey.
+--
+-- This program is free software: you can redistribute it and/or modify
+-- it under the terms of the GNU General Public License as published by
+-- the Free Software Foundation, either version 3 of the License, or
+-- (at your option) any later version.
+--
+-- Clocking (cfide.vhd:515-531): IOclk = clk / 2, toggled on rising clk
+-- edges. Everything below runs on the rising clk edge that raises IOclk
+-- ("tick"), where the inputs are sampled; the outputs computed there are
+-- re-registered on the falling clk edge while IOclk is high, so they
+-- change half a clk period after IOclk rises and the 1k30 samples them at
+-- the next IOclk rise (acex.vhd:86-87). Data the 1k30 launches at IOclk
+-- rise k is sampled at tick k+1, so the round trip (IOclk out to vid in)
+-- must stay below one IOclk period; all cycle counts assume that.
+--
+-- IDE port: hold ide_req high with the access fields stable; they are
+-- latched when the access starts. ide_ack pulses for one clk with
+-- ide_rdata valid (cfide.vhd:377, micro_state = setwaitend). cs0/cs1 are
+-- active high here and inverted onto the 1k30's ide1cs/ide2cs.
+--
+-- Joysticks (cyclone.vhd:206-222), active low:
+-- (5) fire2 (4) fire1 (3) right (2) left (1) down (0) up. The CPLD
+-- stream carries no second fire button, so fire2 is always '1'.
+-- -----------------------------------------------------------------------
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+
+entity cone_mm_link is
+	port (
+		clk : in std_logic;
+		reset : in std_logic;
+
+		-- vid bus (cone_ext_pins.tcl)
+		vid_ioclk : out std_logic;                      -- vid[15]
+		vid_ser_out : out std_logic;                    -- vid[14]
+		vid_ser_in : in std_logic;                      -- vid[13]
+		vid_ide_out : out std_logic_vector(5 downto 0); -- vid[9:4]
+		vid_ide_in : in std_logic_vector(3 downto 0);   -- vid[3:0]
+
+		-- IDE register access through the 1k30
+		ide_req : in std_logic;
+		ide_wr : in std_logic;
+		ide_cs0 : in std_logic;
+		ide_cs1 : in std_logic;
+		ide_reg : in std_logic_vector(2 downto 0);
+		ide_wdata : in std_logic_vector(15 downto 0);
+		ide_rdata : out std_logic_vector(15 downto 0);
+		ide_ack : out std_logic;
+
+		-- PS/2: *_out '0' pulls the 1k30's open-drain line low
+		ps2k_clk_out : in std_logic;
+		ps2k_dat_out : in std_logic;
+		ps2m_clk_out : in std_logic;
+		ps2m_dat_out : in std_logic;
+		ps2k_clk_in : out std_logic;
+		ps2k_dat_in : out std_logic;
+		ps2m_clk_in : out std_logic;
+		ps2m_dat_in : out std_logic;
+
+		txd : in std_logic;
+		rxd : out std_logic;
+		sync_ok : out std_logic;
+
+		joy_a : out unsigned(5 downto 0);
+		joy_b : out unsigned(5 downto 0);
+
+		-- 16-bit samples for the 1k30's serial DAC
+		audio_l : in std_logic_vector(15 downto 0);
+		audio_r : in std_logic_vector(15 downto 0)
+	);
+end entity;
+
+architecture rtl of cone_mm_link is
+	-- cfide.vhd:552,563 (close), :571 (first nibble), :595 (end gap)
+	constant WAIT_CLOSE : unsigned(3 downto 0) := to_unsigned(10, 4);
+	constant WAIT_READ : unsigned(3 downto 0) := to_unsigned(5, 4);
+	constant WAIT_END : unsigned(3 downto 0) := to_unsigned(5, 4);
+
+	type ide_state_t is (idle, ide1, set_addr, set_data1, set_data2, set_data3,
+		waitclose, read1, read2, read3, read4, setwaitend, waitend);
+	signal st : ide_state_t := idle;
+	signal ioclk : std_logic := '0';
+	signal wait_cnt : unsigned(3 downto 0) := (others => '0');
+	signal ide_next : std_logic_vector(5 downto 0) := (others => '1');
+	signal ide_in_q : std_logic_vector(3 downto 0) := (others => '1');
+	signal rdata : std_logic_vector(15 downto 0) := (others => '1');
+	signal acc_wr : std_logic := '0';
+	signal acc_sel : std_logic_vector(5 downto 0) := (others => '1');
+	signal acc_data : std_logic_vector(15 downto 0) := (others => '1');
+
+	signal ide_o : std_logic_vector(5 downto 0) := (others => '1');
+	signal ser_next, ser_o : std_logic := '1';
+	signal kmshift : std_logic_vector(8 downto 0) := (others => '1');
+	signal km_cnt : unsigned(3 downto 0) := (others => '0');
+	signal insync : unsigned(3 downto 0) := (others => '0');
+	signal locked : std_logic := '0';
+	signal c2mhz, c2mhz_d : std_logic := '0';
+	signal ioshift : std_logic := '1';
+	signal kb_clk, kb_dat, ms_clk, ms_dat, rx : std_logic := '1';
+
+	signal lrclk : std_logic := '0';
+	signal count : unsigned(4 downto 0) := (others => '0');
+	signal shift : std_logic_vector(16 downto 0) := (others => '0');
+	signal jshift : std_logic_vector(15 downto 0) := (others => '1');
+	signal ja, jb : unsigned(5 downto 0) := (others => '1');
+begin
+	vid_ioclk <= ioclk;
+	vid_ide_out <= ide_o;
+	vid_ser_out <= ser_o;
+	ide_rdata <= rdata;
+	sync_ok <= locked;
+	ps2k_clk_in <= kb_clk;
+	ps2k_dat_in <= kb_dat;
+	ps2m_clk_in <= ms_clk;
+	ps2m_dat_in <= ms_dat;
+	rxd <= rx;
+	joy_a <= ja;
+	joy_b <= jb;
+
+	-- cfide.vhd:517-520, cyclone.vhd:99-102
+	process(clk)
+	begin
+		if falling_edge(clk) then
+			if ioclk = '1' then
+				ide_o <= ide_next;
+				ser_o <= ser_next;
+			end if;
+		end if;
+	end process;
+
+	process(clk)
+	begin
+		if rising_edge(clk) then
+			ioclk <= not ioclk;
+			ide_ack <= '0';
+			if ioclk = '0' then
+				-- IDE tunnel, cfide.vhd:527-603
+				wait_cnt <= wait_cnt - 1;
+				st <= idle;
+				ide_next <= (others => '1');
+				ide_in_q <= vid_ide_in;
+				case st is
+					when idle =>
+						if ide_req = '1' then
+							acc_wr <= ide_wr;
+							acc_sel <= not ide_cs1 & not ide_cs0 & '0' & ide_reg;
+							acc_data <= ide_wdata;
+							st <= ide1;
+						end if;
+					when ide1 =>
+						ide_next <= acc_wr & not acc_wr & "0000";
+						st <= set_addr;
+					when set_addr =>
+						ide_next <= acc_sel;
+						if acc_wr = '1' then
+							st <= set_data1;
+						else
+							st <= waitclose;
+							wait_cnt <= WAIT_CLOSE;
+						end if;
+					when set_data1 =>
+						ide_next <= acc_data(5 downto 0);
+						st <= set_data2;
+					when set_data2 =>
+						ide_next <= acc_data(11 downto 6);
+						st <= set_data3;
+					when set_data3 =>
+						ide_next(3 downto 0) <= acc_data(15 downto 12);
+						st <= waitclose;
+						wait_cnt <= WAIT_CLOSE;
+					when waitclose =>
+						if wait_cnt = 0 then
+							ide_next <= (others => '0');
+							if acc_wr = '1' then
+								st <= setwaitend;
+							else
+								st <= read1;
+								wait_cnt <= WAIT_READ;
+							end if;
+						else
+							st <= waitclose;
+						end if;
+					when read1 =>
+						if wait_cnt = 0 then
+							st <= read2;
+						else
+							st <= read1;
+						end if;
+						rdata(3 downto 0) <= ide_in_q;
+					when read2 =>
+						rdata(7 downto 4) <= ide_in_q;
+						st <= read3;
+					when read3 =>
+						rdata(11 downto 8) <= ide_in_q;
+						st <= read4;
+					when read4 =>
+						rdata(15 downto 12) <= ide_in_q;
+						st <= setwaitend;
+					when setwaitend =>
+						ide_ack <= '1';
+						wait_cnt <= WAIT_END;
+						st <= waitend;
+					when waitend =>
+						if wait_cnt /= 0 then
+							st <= waitend;
+						end if;
+				end case;
+
+				-- serial slots, cyclone.vhd:106-166
+				ser_next <= '1';
+				kmshift <= kmshift(7 downto 0) & vid_ser_in;
+				km_cnt <= km_cnt + 1;
+				if locked = '1' then
+					case to_integer(km_cnt(2 downto 0)) is
+						when 0 => ser_next <= km_cnt(3);
+						when 1 => ser_next <= ps2k_dat_out;
+						when 2 => ser_next <= ps2k_clk_out;
+						when 3 => ser_next <= ps2m_dat_out;
+						when 4 => ser_next <= ps2m_clk_out;
+						when 5 => ser_next <= txd;
+						when 6 => ser_next <= lrclk;
+						when others => ser_next <= shift(16);
+					end case;
+					case to_integer(km_cnt(2 downto 0)) is
+						when 0 => c2mhz <= kmshift(0);
+						when 1 => ioshift <= kmshift(0);
+						when 3 => kb_dat <= kmshift(0);
+						when 4 => kb_clk <= kmshift(0);
+						when 5 => ms_dat <= kmshift(0);
+						when 6 => ms_clk <= kmshift(0);
+						when 7 => rx <= kmshift(0);
+						when others => null;
+					end case;
+				end if;
+				if km_cnt(2 downto 0) = "010" then
+					if kmshift(8) = kmshift(0) then
+						km_cnt(2 downto 0) <= "010";
+						insync <= (others => '0');
+						locked <= '0';
+					elsif insync = 15 then
+						locked <= '1';
+					else
+						insync <= insync + 1;
+						km_cnt(3) <= kmshift(0);
+					end if;
+				end if;
+			end if;
+
+			-- audio shifter and joystick rebuild on the relayed C2MHz,
+			-- cyclone.vhd:171-222
+			c2mhz_d <= c2mhz;
+			if c2mhz_d = '1' and c2mhz = '0' then
+				if count = 0 then
+					count <= to_unsigned(23, 5);
+					lrclk <= not lrclk;
+					if lrclk = '1' then
+						shift <= '0' & audio_l;
+					else
+						shift <= '0' & audio_r;
+					end if;
+				else
+					count <= count - 1;
+					if count < 17 then
+						shift <= shift(15 downto 0) & '0';
+					end if;
+				end if;
+			end if;
+			if c2mhz_d = '0' and c2mhz = '1' then
+				if jshift(15) = '0' then
+					jshift <= (15 downto 1 => '1') & ioshift;
+					ja <= '1' & jshift(8) & jshift(11) & jshift(10) & jshift(9) & jshift(7);
+					jb <= '1' & jshift(5) & jshift(2) & jshift(3) & jshift(4) & jshift(6);
+				else
+					jshift <= jshift(14 downto 0) & ioshift;
+				end if;
+			end if;
+
+			if reset = '1' then
+				st <= idle;
+				locked <= '0';
+				insync <= (others => '0');
+				kb_clk <= '1';
+				kb_dat <= '1';
+				ms_clk <= '1';
+				ms_dat <= '1';
+				rx <= '1';
+				ja <= (others => '1');
+				jb <= (others => '1');
+			end if;
+		end if;
+	end process;
+end architecture;
diff --git a/Board/cone_ext/cone_sd_ata.vhd b/Board/cone_ext/cone_sd_ata.vhd
new file mode 100644
index 0000000..65ab5a3
--- /dev/null
+++ b/Board/cone_ext/cone_sd_ata.vhd
@@ -0,0 +1,359 @@
+-- -----------------------------------------------------------------------
+-- cone_sd_ata.vhd
+--
+-- SD-card-in-SPI-mode front end for an ATA/CF device, so DeMiSTify's
+-- unchanged firmware (firmware/spi_sd.c) reaches the C-One's CF slot
+-- through cone_mm_link's IDE tunnel. Copyright (c) 2026 Josh Bailey.
+--
+-- This program is free software: you can redistribute it and/or modify
+-- it under the terms of the GNU General Public License as published by
+-- the Free Software Foundation, either version 3 of the License, or
+-- (at your option) any later version.
+--
+-- SPI: mode 0 slave on substitute_mcu's raw SD port. spi_controller
+-- raises SCK and samples MISO on the same controller clock edge, so MISO
+-- (tx(7)) moves only after a rising SCK has been seen here, and the next
+-- byte is loaded on the eighth rising edge. SCK, MOSI and CS come from
+-- registers clocked by a PLL output related to clk; no synchroniser.
+--
+-- SD commands, encoded as spi_sd.c:36-45 sends them; responses start in
+-- the second byte after the CRC byte, and R1 waits there (0xFF) until the
+-- ATA side is idle (spi_sd.c:118-125 polls up to 40000 bytes):
+--   CMD0   R1 0x01, enter idle
+--   CMD8   R1 + 00 00 0v aa (echo of arg[11:0]; spi_sd.c:208-209)
+--   CMD55  R1
+--   CMD41  R1 0x00, leave idle (sent after CMD55, spi_sd.c:149-152)
+--   CMD58  R1 + OCR C0 FF 80 00 (power-up done, CCS; spi_sd.c:232-238)
+--   CMD9   ATA IDENTIFY, then FE + 16-byte CSD v2 + FF FF (spi_sd.c:417-420
+--          reads only byte 0 and C_SIZE in bytes 7-9)
+--   CMD16  R1
+--   CMD17  ATA READ SECTORS, FF while it runs, FE + 512 bytes + FF FF, or
+--          the data error token 01 if the device reports ERR
+--   CMD24  R1, then FE + 512 bytes + 2 CRC bytes from the host; data
+--          response 05, 00 until the ATA write completes, then FF
+--   other  R1 0x04 (illegal command)
+-- R1 carries the idle bit (bit 0) for every supported command.
+--
+-- ATA: PIO, LBA28, device 0 on CS0, one sector per command, in the order
+-- of Minimig's _MMC_Read/_MMC_Write (Armreplacement/start.asm:113-268):
+-- wait BSY=0 and DRDY=1, sector count 1, LBA 3-5, device E0|LBA[27:24],
+-- command; wait BSY=0 and DRQ=1 (or ERR); 256 data words, low byte first;
+-- after a write, wait BSY=0. Registers: Gayle.v:59-66 (0 data, 2 count,
+-- 3-5 LBA, 6 device/head, 7 status/command); status bits Gayle.v:88-91
+-- (7 BSY, 6 DRDY, 3 DRQ, 0 ERR); commands start.asm:16-19 (20 read,
+-- 30 write, EC identify). IDENTIFY words 60-61 hold the LBA28 sector
+-- count (DeMiSTify firmware/ide.c:145-146); the CSD reports
+-- C_SIZE = sectors / 1024 - 1, which spi_sd.c:419-420 turns back into
+-- (C_SIZE + 1) * 1024 sectors.
+-- -----------------------------------------------------------------------
+
+library ieee;
+use ieee.std_logic_1164.all;
+use ieee.numeric_std.all;
+
+entity cone_sd_ata is
+	port (
+		clk : in std_logic;
+		reset : in std_logic;
+
+		spi_cs_n : in std_logic;
+		spi_sck : in std_logic;
+		spi_mosi : in std_logic;
+		spi_miso : out std_logic;
+
+		-- cone_mm_link IDE port (CS0)
+		ide_req : out std_logic;
+		ide_wr : out std_logic;
+		ide_reg : out std_logic_vector(2 downto 0);
+		ide_wdata : out std_logic_vector(15 downto 0);
+		ide_rdata : in std_logic_vector(15 downto 0);
+		ide_ack : in std_logic
+	);
+end entity;
+
+architecture rtl of cone_sd_ata is
+	constant BSY : natural := 7;
+	constant DRDY : natural := 6;
+	constant DRQ : natural := 3;
+	constant ERR : natural := 0;
+
+	-- sd: what the byte now being clocked belongs to
+	--   s_cmd    idle, FF out, waiting for a command byte
+	--   s_arg    argument and CRC bytes in
+	--   s_ncr    FF out until the ATA side is idle, then R1 is loaded
+	--   s_tail   R1 out, then the four R7/OCR bytes
+	--   s_rdwait FF out until the ATA read/identify completes
+	--   s_data   token out, then the data block
+	--   s_wrtok  FF out, waiting for the host's FE token
+	--   s_wrdata data block and CRC in
+	--   s_wrbusy data response out, then busy until the ATA write completes
+	type sd_state_t is (s_cmd, s_arg, s_ncr, s_tail, s_rdwait, s_data, s_wrtok, s_wrdata, s_wrbusy);
+	signal sd : sd_state_t := s_cmd;
+	signal sck_d : std_logic := '1';
+	signal bitn : unsigned(2 downto 0) := (others => '0');
+	signal rx : std_logic_vector(6 downto 0) := (others => '1');
+	signal tx : std_logic_vector(7 downto 0) := (others => '1');
+	signal cmd : natural range 0 to 63 := 0;
+	signal arg : std_logic_vector(31 downto 0) := (others => '0');
+	signal n : unsigned(9 downto 0) := (others => '0');
+	signal idle : std_logic := '1';
+	signal even : std_logic_vector(7 downto 0) := (others => '0');
+
+	-- ATA side: step 0 idle, 1 wait ready, 2-7 write registers 2-7,
+	-- 8 wait DRQ, 9 data words, 10 wait write completion
+	type op_t is (op_identify, op_read, op_write);
+	signal op : op_t := op_read;
+	signal go : std_logic := '0';
+	signal failed : std_logic := '0';
+	signal step : natural range 0 to 10 := 0;
+	signal w : unsigned(7 downto 0) := (others => '0');
+	signal lba : std_logic_vector(27 downto 0) := (others => '0');
+	signal sectors : unsigned(27 downto 0) := (others => '0');
+	signal ata_idle : boolean;
+	signal cmd_byte : std_logic_vector(7 downto 0);
+
+	type ram_t is array (0 to 255) of std_logic_vector(15 downto 0);
+	signal ram : ram_t;
+	signal ram_we : std_logic := '0';
+	signal ram_wa, ram_ra : unsigned(7 downto 0) := (others => '0');
+	signal ram_wd, ram_q : std_logic_vector(15 downto 0) := (others => '0');
+
+	function r1_of(c : natural; idl : std_logic) return std_logic_vector is
+	begin
+		case c is
+			when 0 => return x"01";
+			when 41 => return x"00";
+			when 8 | 9 | 16 | 17 | 24 | 55 | 58 => return "0000000" & idl;
+			when others => return "00000" & "10" & idl;
+		end case;
+	end function;
+
+	function tail_of(c : natural; a : std_logic_vector(31 downto 0); k : unsigned(1 downto 0))
+		return std_logic_vector is
+		variable r : std_logic_vector(31 downto 0) := x"00000" & a(11 downto 0);
+	begin
+		if c = 58 then
+			r := x"C0FF8000";
+		end if;
+		case k is
+			when "00" => return r(31 downto 24);
+			when "01" => return r(23 downto 16);
+			when "10" => return r(15 downto 8);
+			when others => return r(7 downto 0);
+		end case;
+	end function;
+
+	function csd_of(k : unsigned(3 downto 0); csize : unsigned(21 downto 0)) return std_logic_vector is
+	begin
+		case to_integer(k) is
+			when 0 => return x"40";
+			when 7 => return "00" & std_logic_vector(csize(21 downto 16));
+			when 8 => return std_logic_vector(csize(15 downto 8));
+			when 9 => return std_logic_vector(csize(7 downto 0));
+			when others => return x"00";
+		end case;
+	end function;
+begin
+	spi_miso <= tx(7);
+	ata_idle <= step = 0 and go = '0';
+	ram_ra <= w when step /= 0 else n(8 downto 1);
+
+	ide_req <= '0' when step = 0 else '1';
+	ide_reg <= "000" when step = 9 else
+		std_logic_vector(to_unsigned(step, 3)) when step >= 2 and step <= 7 else "111";
+	ide_wr <= '1' when (step >= 2 and step <= 7) or (step = 9 and op = op_write) else '0';
+	with op select cmd_byte <=
+		x"EC" when op_identify,
+		x"20" when op_read,
+		x"30" when op_write;
+	with step select ide_wdata <=
+		x"0001" when 2,
+		x"00" & lba(7 downto 0) when 3,
+		x"00" & lba(15 downto 8) when 4,
+		x"00" & lba(23 downto 16) when 5,
+		x"00E" & lba(27 downto 24) when 6,
+		x"00" & cmd_byte when 7,
+		ram_q when others;
+
+	process(clk)
+	begin
+		if rising_edge(clk) then
+			if ram_we = '1' then
+				ram(to_integer(ram_wa)) <= ram_wd;
+			end if;
+			ram_q <= ram(to_integer(ram_ra));
+		end if;
+	end process;
+
+	process(clk)
+		variable b : std_logic_vector(7 downto 0);
+	begin
+		if rising_edge(clk) then
+			ram_we <= '0';
+
+			-- ATA sequencer
+			if step = 0 and go = '1' then
+				step <= 1;
+				go <= '0';
+				failed <= '0';
+			elsif ide_ack = '1' then
+				case step is
+					when 1 =>
+						if ide_rdata(BSY) = '0' and ide_rdata(DRDY) = '1' then
+							step <= 2;
+						end if;
+					when 8 =>
+						if ide_rdata(BSY) = '0' then
+							if ide_rdata(ERR) = '1' then
+								failed <= '1';
+								step <= 0;
+							elsif ide_rdata(DRQ) = '1' then
+								w <= (others => '0');
+								step <= 9;
+							end if;
+						end if;
+					when 9 =>
+						w <= w + 1;
+						if op /= op_write then
+							ram_we <= '1';
+							ram_wa <= w;
+							ram_wd <= ide_rdata;
+						end if;
+						if op = op_identify and w = 60 then
+							sectors(15 downto 0) <= unsigned(ide_rdata);
+						end if;
+						if op = op_identify and w = 61 then
+							sectors(27 downto 16) <= unsigned(ide_rdata(11 downto 0));
+						end if;
+						if w = 255 and op = op_write then
+							step <= 10;
+						elsif w = 255 then
+							step <= 0;
+						end if;
+					when 10 =>
+						if ide_rdata(BSY) = '0' then
+							failed <= ide_rdata(ERR);
+							step <= 0;
+						end if;
+					when others =>
+						step <= step + 1;
+				end case;
+			end if;
+
+			-- SPI slave
+			sck_d <= spi_sck;
+			if spi_cs_n = '1' then
+				bitn <= (others => '0');
+				tx <= (others => '1');
+				sd <= s_cmd;
+			elsif sck_d = '0' and spi_sck = '1' then
+				rx <= rx(5 downto 0) & spi_mosi;
+				bitn <= bitn + 1;
+				tx <= tx(6 downto 0) & '1';
+				if bitn = 7 then
+					b := rx & spi_mosi;
+					tx <= x"FF";
+					case sd is
+						when s_cmd =>
+							if b(7 downto 6) = "01" then
+								cmd <= to_integer(unsigned(b(5 downto 0)));
+								n <= (others => '0');
+								sd <= s_arg;
+							end if;
+						when s_arg =>
+							n <= n + 1;
+							if n = 4 then
+								sd <= s_ncr;
+							else
+								arg <= arg(23 downto 0) & b;
+							end if;
+						when s_ncr =>
+							if ata_idle then
+								tx <= r1_of(cmd, idle);
+								n <= (others => '0');
+								sd <= s_cmd;
+								case cmd is
+									when 0 => idle <= '1';
+									when 41 => idle <= '0';
+									when 8 | 58 => sd <= s_tail;
+									when 9 | 17 =>
+										op <= op_read;
+										if cmd = 9 then
+											op <= op_identify;
+										end if;
+										lba <= arg(27 downto 0);
+										go <= '1';
+										sd <= s_rdwait;
+									when 24 => sd <= s_wrtok;
+									when others => null;
+								end case;
+							end if;
+						when s_tail =>
+							n <= n + 1;
+							if n = 4 then
+								sd <= s_cmd;
+							else
+								tx <= tail_of(cmd, arg, n(1 downto 0));
+							end if;
+						when s_rdwait =>
+							if ata_idle then
+								n <= (others => '0');
+								if failed = '1' then
+									tx <= x"01";
+									sd <= s_cmd;
+								else
+									tx <= x"FE";
+									sd <= s_data;
+								end if;
+							end if;
+						when s_data =>
+							n <= n + 1;
+							if (op = op_identify and n = 16) or n = 512 then
+								sd <= s_cmd;
+							elsif op = op_identify then
+								tx <= csd_of(n(3 downto 0), resize(sectors(27 downto 10) - 1, 22));
+							elsif n(0) = '0' then
+								tx <= ram_q(7 downto 0);
+							else
+								tx <= ram_q(15 downto 8);
+							end if;
+						when s_wrtok =>
+							if b = x"FE" then
+								n <= (others => '0');
+								sd <= s_wrdata;
+							end if;
+						when s_wrdata =>
+							n <= n + 1;
+							if n(0) = '0' then
+								even <= b;
+							elsif n < 512 then
+								ram_we <= '1';
+								ram_wa <= n(8 downto 1);
+								ram_wd <= b & even;
+							end if;
+							if n = 513 then
+								tx <= x"05";
+								op <= op_write;
+								lba <= arg(27 downto 0);
+								go <= '1';
+								sd <= s_wrbusy;
+							end if;
+						when s_wrbusy =>
+							if ata_idle then
+								sd <= s_cmd;
+							else
+								tx <= x"00";
+							end if;
+					end case;
+				end if;
+			end if;
+
+			if reset = '1' then
+				step <= 0;
+				go <= '0';
+				idle <= '1';
+				sd <= s_cmd;
+			end if;
+		end if;
+	end process;
+end architecture;
diff --git a/Board/cone_ext/constraints.sdc b/Board/cone_ext/constraints.sdc
new file mode 100644
index 0000000..3b8e317
--- /dev/null
+++ b/Board/cone_ext/constraints.sdc
@@ -0,0 +1,73 @@
+# C-One FPGA Extender timing constraints
+create_clock -name "clk28" -period 35.242ns [get_ports {clk28}]
+create_clock -name "clk14" -period 69.841ns [get_ports {clk14}]
+
+# Host PLL: hostclocks (clk14 -> c0 = 100 MHz vid-bus/SDRAM, c1 = 50 MHz
+# controller, c2 = 27 MHz guest CLOCK_27)
+set hostclk {clocks|pll|auto_generated|pll1|clk[1]}
+set supportclk {clocks|pll|auto_generated|pll1|clk[0]}
+
+create_generated_clock -name spiclk -source [get_pins ${hostclk}] -divide_by 4 [get_registers {substitute_mcu:controller|spi_controller:spi|sck}]
+create_generated_clock -name spiclkfast -source [get_pins ${supportclk}] -divide_by 4 [get_registers {substitute_mcu:controller|spi_controller:spi|sck}]
+
+derive_pll_clocks -create_base_clocks
+derive_clock_uncertainty
+
+# Pin groups for DeMiSTify's downstream constraints
+set RAM_CLK ram_clk
+set RAM_OUT {ram_data* ram_addr* ram_ba* ram_ras_n ram_cas_n ram_we_n ram_*dqm}
+set RAM_IN {ram_data*}
+
+set VGA_OUT {red* grn* blu* hsync_oc vsync_oc}
+
+set FALSE_OUT {sigma_l sigma_r vid_spare_out}
+set FALSE_IN {mdb* vid_spare_in*}
+
+set_false_path -to [get_ports {ram_clk}]
+
+# vid-bus link to the 1k30 (cone_mm_link). IOclk is clk_100 / 2 from the
+# register cone_mm_link|ioclk and is the only clock of the 1k30's link
+# logic (acex.vhd:84-86), so the board-side delays are given against the
+# vid_ioclk pin. They are not known (BLOCKED.md #3): 0.5 ns placeholders as
+# in DeMiSTify's chameleon64 constraints, so the reported slack is the
+# budget left for wires and the 1k30.
+set ioclk_reg {*cone_mm_link:*|ioclk}
+create_generated_clock -name ioclk -source [get_pins ${supportclk}] -divide_by 2 [get_registers $ioclk_reg]
+create_generated_clock -name vid_ioclk -source [get_registers $ioclk_reg] [get_ports {vid_ioclk}]
+
+# Extender -> 1k30: launched on the clk_100 falling edge while IOclk is
+# high (cfide.vhd:517-520), captured on the next IOclk rise (acex.vhd:86-87)
+# 1.5 clk_100 periods later; the IOclk rise 0.5 periods before the launch
+# bounds the hold. -start moves the launch back to the enabled falling edge.
+set_output_delay -clock vid_ioclk 0.5 [get_ports {vid_ide_out[*] vid_ser_out}]
+set_multicycle_path -setup -start 2 -from [get_clocks ${supportclk}] -to [get_clocks vid_ioclk]
+set_multicycle_path -hold -start 1 -from [get_clocks ${supportclk}] -to [get_clocks vid_ioclk]
+
+# 1k30 -> extender: launched on IOclk rise k (acex.vhd:89,174), sampled on
+# the clk_100 edge that raises IOclk k+1 (cfide.vhd:527-531,
+# cyclone.vhd:133-134), two clk_100 periods later; the launch on that same
+# IOclk rise bounds the hold.
+set_input_delay -clock vid_ioclk 0.5 [get_ports {vid_ide_in[*] vid_ser_in}]
+set_multicycle_path -setup -end 2 -from [get_clocks vid_ioclk] -to [get_clocks ${supportclk}]
+set_multicycle_path -hold -end 1 -from [get_clocks vid_ioclk] -to [get_clocks ${supportclk}]
+
+# The guest's SPI_SCK is substitute_mcu's sck register, which the
+# divide-by-4 spiclk above stands in for. The selects and conf_data0 are
+# written by the controller CPU only while the SPI is idle (busy low), at
+# least one controller clock after the last SCK edge and before the next
+# trigger, so they are static with respect to spiclk; guests use them as
+# asynchronous resets of their SPI logic.
+set_false_path -from [get_registers {substitute_mcu:controller|spi_ss* substitute_mcu:controller|conf_data0}] -to [get_clocks {spiclk spiclkfast}]
+
+# spi_controller changes MOSI with the falling SCK step; with SPI_FASTBIT 0
+# the next (rising) step comes two controller cycles later at the earliest
+# (substitute_mcu.vhd:377-383).
+set_multicycle_path -setup -start 2 -from [get_registers {substitute_mcu:controller|spi_controller:spi|mosi}] -to [get_clocks {spiclk spiclkfast}]
+set_multicycle_path -hold -start 1 -from [get_registers {substitute_mcu:controller|spi_controller:spi|mosi}] -to [get_clocks {spiclk spiclkfast}]
+
+# JTAG (debug interface, if enabled)
+set_input_delay -clock altera_reserved_tck -clock_fall 3 altera_reserved_tdi
+set_input_delay -clock altera_reserved_tck -clock_fall 3 altera_reserved_tms
+set_output_delay -clock altera_reserved_tck 3 altera_reserved_tdo
+
+set topmodule guest|
diff --git a/Board/cone_ext/gen_reset.vhd b/Board/cone_ext/gen_reset.vhd
